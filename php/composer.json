{
  "name": "crawlora/bo3",
  "description": "Crawlora BO3.gg API client with 28 endpoints for Counter-Strike and Valorant matches, teams, players, tournaments, rankings, news, and statistics",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "bo3",
    "bo3-gg",
    "bo3-api",
    "bo3-gg-api",
    "bo3-scraper",
    "bo3-gg-scraper",
    "bo3-data",
    "bo3-gg-data",
    "bo3-teams",
    "bo3-players",
    "bo3-tournaments",
    "bo3-rankings",
    "bo3-news",
    "bo3-statistics"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Bo3\\": "src/Crawlora/Bo3/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Bo3\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=bo3-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-bo3",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=bo3-php-api-docs"
  }
}
