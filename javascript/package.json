{
  "name": "@crawlora-org/bo3",
  "version": "0.1.0",
  "description": "Crawlora BO3.gg API client with 28 endpoints for Counter-Strike and Valorant matches, teams, players, tournaments, rankings, news, and statistics",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=bo3-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-bo3/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "bo3", "bo3-gg", "bo3-api", "bo3-gg-api", "bo3-scraper", "bo3-gg-scraper", "bo3-data", "bo3-gg-data", "bo3-teams", "bo3-players", "bo3-tournaments", "bo3-rankings", "bo3-news", "bo3-statistics"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-bo3",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
